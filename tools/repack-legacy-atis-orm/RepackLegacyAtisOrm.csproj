<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>RepackLegacyAtisOrm</AssemblyName>
		<!-- Build tooling only: never packed, and deliberately kept out of atis-orm.sln so a
		     normal solution build/restore does not depend on it. Run it by path (see README.md). -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Rewrites the assembly identity in place. Chosen over an ildasm/ilasm round trip because
		     it changes only the fields we name and leaves every method body byte-identical. -->
		<PackageReference Include="Mono.Cecil" Version="0.11.6" />
	</ItemGroup>

</Project>
