<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<config>
		<add key="globalPackagesFolder" value=".\packages_rep" />
		<add key="repositoryPath" value=".\packages_rep" />
	</config>
	<packageSources>
		<!-- Cleared so a restore does not depend on whatever sources happen to be configured
		     machine-wide: everyone who clones this repo restores from exactly these two. -->
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<!-- Atis.ORM 9.16.4 (the legacy engine the benchmarks compare against) was never published
		     to nuget.org, so the .nupkg is vendored in-repo and restored from this folder source.
		     See local-packages/README.md. -->
		<add key="atis-local" value=".\local-packages" />
	</packageSources>
</configuration>
