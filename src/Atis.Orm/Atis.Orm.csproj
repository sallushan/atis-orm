<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- netstandard2.0 keeps .NET Framework / older .NET Core reach; net8.0 activates the real
		     CloseAsync/DisposeAsync paths (see the NETCOREAPP3_0_OR_GREATER blocks in DbCommunicationBase
		     and DbAsyncEnumerator) and lets Atis.Orm.SqlServer bind Microsoft.Data.SqlClient 6.x. -->
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<Title>Atis ORM</Title>
		<Version>1.0.0</Version>
		<Authors>AT Integrated Systems</Authors>
		<Company>AT Integrated Systems</Company>
		<Product>Atis ORM</Product>
		<Description>Extremely lightweight ORM which aims to allow developers to write most complex SQL Queries in LINQ.</Description>
		<Copyright>Copyright (c) AT Integrated Systems</Copyright>
		<PackageTags>Atis,ORM,Database</PackageTags>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>
	<PropertyGroup>
		<DebugType>portable</DebugType>
		<!-- Ensures PDBs are generated -->
		<IncludeSymbols>true</IncludeSymbols>
		<IncludeSource>true</IncludeSource>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<UserSecretsId>a7239b99-fadf-48f2-b605-0d313cc91f5e</UserSecretsId>
		<!-- Generates symbol packages in the .snupkg format -->
	</PropertyGroup>
	<ItemGroup>
	  <!-- 2.1.0 or later: it floors Microsoft.Extensions.DependencyInjection at 10.0.10. Earlier versions
	       floor it at 3.1.0, whose IL emitting resolver mis-compiles a scoped service produced by a factory
	       delegate and throws InvalidProgramException once a call site is hot enough to be compiled —
	       IOrmModel is registered exactly that way. -->
	  <PackageReference Include="Atzonix.DependencyInjection" Version="2.1.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
	  <!-- IAsyncEnumerable/IAsyncDisposable are in the BCL from net8.0 onwards. Kept in step with the
	       Microsoft.Extensions.DependencyInjection that Atzonix.DependencyInjection floors, which depends
	       on this package on netstandard2.0 and would otherwise resolve as a downgrade. -->
	  <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Atis.SqlExpressionEngine\Atis.SqlExpressionEngine.csproj" />
	</ItemGroup>

</Project>
